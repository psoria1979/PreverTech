generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JEFE
  EMPLEADO
}

enum MachineStatus {
  OPERATIVA
  EN_MANTENIMIENTO
  FUERA_DE_SERVICIO
}

enum WorkType {
  PREDICTIVO
  PREVENTIVO
  CORRECTIVO
  MEJORA
  INSPECCION
}

enum Priority {
  BAJA
  MEDIA
  ALTA
  CRITICA
}

enum OrderStatus {
  PENDIENTE
  EN_PROGRESO
  COMPLETADA
  CANCELADA
}

enum Visibility {
  SOLO_JEFES
  ASIGNADOS
  TODOS
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  pinHash       String
  name          String
  role          Role      @default(EMPLEADO)
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  createdOrders WorkOrder[]            @relation("CreatedOrders")
  assignments   WorkOrderAssignment[]
  notifications Notification[]
  comments      OrderComment[]
  partUsages    PartUsage[]
  timeLogs      TimeLog[]
}

model Machine {
  id          String        @id @default(cuid())
  code        String        @unique
  name        String
  location    String?
  description String?
  status      MachineStatus @default(OPERATIVA)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orders WorkOrder[]
  plans  MaintenancePlan[]
}

model WorkOrder {
  id           String       @id @default(cuid())
  number       Int          @unique @default(autoincrement())
  title        String
  description  String
  type         WorkType
  priority     Priority     @default(MEDIA)
  status       OrderStatus  @default(PENDIENTE)
  visibility   Visibility   @default(SOLO_JEFES)
  scheduledFor DateTime?
  completedAt  DateTime?
  notes        String?

  machineId String
  machine   Machine @relation(fields: [machineId], references: [id], onDelete: Restrict)

  creatorId String
  creator   User   @relation("CreatedOrders", fields: [creatorId], references: [id])

  assignments WorkOrderAssignment[]
  photos      WorkOrderPhoto[]
  notifications Notification[]
  comments    OrderComment[]
  partUsages  PartUsage[]
  timeLogs    TimeLog[]

  planId String?
  plan   MaintenancePlan? @relation("GeneratedFromPlan", fields: [planId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([machineId])
  @@index([createdAt])
  @@index([planId])
}

model WorkOrderPhoto {
  id          String   @id @default(cuid())
  workOrderId String
  filename    String
  mimeType    String
  size        Int
  data        Bytes
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model OrderComment {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  body        String
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  title       String
  message     String
  workOrderId String?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: SetNull)

  @@index([userId, readAt])
  @@index([createdAt])
}

model WorkOrderAssignment {
  id          String    @id @default(cuid())
  workOrderId String
  userId      String
  createdAt   DateTime  @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workOrderId, userId])
  @@index([userId])
}

model Part {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  unit        String   @default("u")
  description String?
  stock       Float    @default(0)
  minStock    Float    @default(0)
  unitCost    Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  usages PartUsage[]
}

model PartUsage {
  id          String   @id @default(cuid())
  workOrderId String
  partId      String
  userId      String
  quantity    Float
  unitCost    Float
  note        String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  part      Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([partId])
}

model TimeLog {
  id          String   @id @default(cuid())
  workOrderId String
  userId      String
  minutes     Int
  note        String?
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id])

  @@index([workOrderId])
  @@index([userId])
}

model MaintenancePlan {
  id              String     @id @default(cuid())
  name            String
  description     String?
  machineId       String
  type            WorkType
  priority        Priority   @default(MEDIA)
  visibility      Visibility @default(SOLO_JEFES)
  frequencyDays   Int
  active          Boolean    @default(true)
  lastGeneratedAt DateTime?
  nextDueAt       DateTime
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  machine          Machine     @relation(fields: [machineId], references: [id], onDelete: Cascade)
  generatedOrders  WorkOrder[] @relation("GeneratedFromPlan")

  @@index([active, nextDueAt])
}
